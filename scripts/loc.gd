	"log.data_incident": {"en": "DATA INCIDENT: a disk from the decommissioned %s turned up on a resale site with customer data still on it. $1500 and a great deal of trust.", "hu": "ADATINCIDENS: a leszerelt %s egyik lemeze felbukkant egy használtcikk-oldalon, rajta még ügyféladatokkal. 1500 $ és rengeteg bizalom."},
	"log.quiet_floor": {"en": "QUIET: the floor is dressed, blanked and labelled. Faults are rarer here and repairs are quicker.", "hu": "CSEND: a szint rendezett, vakpanelezett és címkézett. Itt ritkább a hiba, és gyorsabb a javítás."},
	"log.heads_up_rang": {"en": "HEADS UP: %s rang first: their circuits went the same way ten minutes ago. %s", "hu": "FIGYELEM: %s hívott először: az ő áramköreik tíz perce ugyanígy jártak. %s"},
	"log.upstream_not_yours": {"en": "UPSTREAM: %s. This one is not yours to fix: open a case, chase it, and tell your customers before they ask.", "hu": "UPSTREAM: %s. Ezt nem te javítod: nyiss ügyet, sürgesd, és szólj az ügyfeleidnek, mielőtt kérdeznek."},
	"log.upstream_case": {"en": "UPSTREAM: case %s raised with %s. Now you wait, and chase.", "hu": "UPSTREAM: %s ügy megnyitva náluk: %s. Most vársz, és sürgetsz."},
